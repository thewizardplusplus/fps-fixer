#!/usr/bin/env bash
set -euo pipefail

log_file="${FFMPEG_LOG_FILE:-}"
if [[ -n "$log_file" ]]; then
  printf '%s\n' "$*" >> "$log_file"
fi

if [[ -n "${FFMPEG_FAIL_MATCH:-}" && "$*" == *"${FFMPEG_FAIL_MATCH}"* ]]; then
  echo "mock processing failure" >&2
  exit 1
fi

# create output file (last arg)
out="${!#}"
mkdir -p "$(dirname "$out")"
touch "$out"
